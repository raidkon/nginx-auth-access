[Unit]
Description=nginx-auth-access — login panel and auth_request verify for nginx
Documentation=https://github.com/raidkon/nginx-auth-access
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nginx-auth-access
Group=nginx-auth-access
ExecStart=/usr/local/bin/nginx-auth-access -config /etc/nginx-auth-access/config.toml
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
